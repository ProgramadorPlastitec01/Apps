	<property name="ireport.callouts" value="##Wed Oct 24 10:23:40 COT 2012"/>
	<parameter name="idanalisiscabe" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     a.`Analisis`,
     armu.`Descripcion`,
     tip.`Descripcion`,
     a.`Volumen_Muestrado`,
     a.`Producto`,
     a.`Micro_Orga_a_m`,
     a.`Micro_Orga_Hongos`,
     a.`Micro_Orga_Levad`,
     uni.`Descripcion`,
     a.`Concepto`,
     de.`Descripcion` AS de_Descripcion,
     a.`Lote_Producto` AS a_Lote_Producto,
     a.`Observaciones` AS a_Observaciones,
     c.`Especificaciones` AS c_Especificaciones
FROM
     `cabecera` c INNER JOIN `analisis_por_area` a ON c.`idCabecera` = a.`Cabecera_idCabecera`
     INNER JOIN `desinfectante` de ON a.`Desinfectante_idDesinfectante` = de.`idDesinfectante`
     INNER JOIN `area_muestrada` armu ON a.`Area_Muestrada_idArea_Muestrada` = armu.`idArea_Muestrada`
     INNER JOIN `tipo_area` tip ON a.`Tipo_Area_idTipo_Area` = tip.`idTipo_Area`
     INNER JOIN `unidades` uni ON a.`Unidades_IdUnidades` = uni.`idUnidades`
WHERE
     a.Cabecera_idCabecera = $P{idanalisiscabe}]]>
	</queryString>
