<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    <servlet>
        <servlet-name>Sesion</servlet-name>
        <servlet-class>Servlets.Sesion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Usuario</servlet-name>
        <servlet-class>Servlets.Usuario</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Complemento</servlet-name>
        <servlet-class>Servlets.Complemento</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Equipo</servlet-name>
        <servlet-class>Servlets.Equipo</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Orden_trabajo</servlet-name>
        <servlet-class>Servlets.Orden_trabajo</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Horometro</servlet-name>
        <servlet-class>Servlets.Horometro</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Informe</servlet-name>
        <servlet-class>Servlets.Informe</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Sesion</servlet-name>
        <url-pattern>/Sesion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Usuario</servlet-name>
        <url-pattern>/Usuario</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Complemento</servlet-name>
        <url-pattern>/Complemento</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Equipo</servlet-name>
        <url-pattern>/Equipo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Orden_trabajo</servlet-name>
        <url-pattern>/Orden_trabajo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Horometro</servlet-name>
        <url-pattern>/Horometro</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Informe</servlet-name>
        <url-pattern>/Informe</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            240
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
