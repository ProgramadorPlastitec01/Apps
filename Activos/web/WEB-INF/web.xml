<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <servlet>
        <servlet-name>Activo</servlet-name>
        <servlet-class>Servlets.Activo</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Area</servlet-name>
        <servlet-class>Servlets.Area</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Clasificacion</servlet-name>
        <servlet-class>Servlets.Clasificacion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EmailNotificacion</servlet-name>
        <servlet-class>Servlets.EmailNotificacion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Proceso</servlet-name>
        <servlet-class>Servlets.Proceso</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Proveedor</servlet-name>
        <servlet-class>Servlets.Proveedor</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Requisicion</servlet-name>
        <servlet-class>Servlets.Requisicion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Sesion</servlet-name>
        <servlet-class>Servlets.Sesion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Ubicacion</servlet-name>
        <servlet-class>Servlets.Ubicacion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Usuario</servlet-name>
        <servlet-class>Servlets.Usuario</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Unidad</servlet-name>
        <servlet-class>Servlets.Unidad</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Activo</servlet-name>
        <url-pattern>/Activo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Area</servlet-name>
        <url-pattern>/Area</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Clasificacion</servlet-name>
        <url-pattern>/Clasificacion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EmailNotificacion</servlet-name>
        <url-pattern>/EmailNotificacion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Proceso</servlet-name>
        <url-pattern>/Proceso</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Proveedor</servlet-name>
        <url-pattern>/Proveedor</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Requisicion</servlet-name>
        <url-pattern>/Requisicion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Sesion</servlet-name>
        <url-pattern>/Sesion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Ubicacion</servlet-name>
        <url-pattern>/Ubicacion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Usuario</servlet-name>
        <url-pattern>/Usuario</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Unidad</servlet-name>
        <url-pattern>/Unidad</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            260
        </session-timeout>
    </session-config>
    <servlet>
        <servlet-name>Connector</servlet-name>
        <servlet-class>com.fredck.FCKeditor.connector.ConnectorServlet</servlet-class>
        <init-param>
            <param-name>baseDir</param-name>
            <param-value>/UserFiles/</param-value>
        </init-param>
        <init-param>
            <param-name>debug</param-name>
            <param-value>true</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>SimpleUploader</servlet-name>
        <servlet-class>com.fredck.FCKeditor.uploader.SimpleUploaderServlet</servlet-class>
        <init-param>
            <param-name>baseDir</param-name>
            <param-value>/UserFiles/</param-value>
        </init-param>
        <init-param>
            <param-name>debug</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>enabled</param-name>
            <param-value>false</param-value>
        </init-param>
        <init-param>
            <param-name>AllowedExtensionsFile</param-name>
            <param-value/>
        </init-param>
        <init-param>
            <param-name>DeniedExtensionsFile</param-name>
            <param-value>php|php3|php5|phtml|asp|aspx|ascx|jsp|cfm|cfc|pl|bat|exe|dll|reg|cgi</param-value>
        </init-param>
        <init-param>
            <param-name>AllowedExtensionsImage</param-name>
            <param-value>jpg|gif|jpeg|png|bmp</param-value>
        </init-param>
        <init-param>
            <param-name>DeniedExtensionsImage</param-name>
            <param-value/>
        </init-param>
        <init-param>
            <param-name>AllowedExtensionsFlash</param-name>
            <param-value>swf|fla</param-value>
        </init-param>
        <init-param>
            <param-name>DeniedExtensionsFlash</param-name>
            <param-value/>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Connector</servlet-name>
        <url-pattern>/tinyfck/filemanager/connectors/jsp/connector</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SimpleUploader</servlet-name>
        <url-pattern>/tinyfck/filemanager/upload/simpleuploader</url-pattern>
    </servlet-mapping>
</web-app>
