<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <servlet>
        <servlet-name>Login</servlet-name>
        <servlet-class>Servlets.Login</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Bitacora</servlet-name>
        <servlet-class>Servlets.Bitacora</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Caso</servlet-name>
        <servlet-class>Servlets.Caso</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Calificar_caso</servlet-name>
        <servlet-class>Servlets.Calificar_caso</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Detalle_equipo</servlet-name>
        <servlet-class>Servlets.Detalle_equipo</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Encuesta</servlet-name>
        <servlet-class>Servlets.Encuesta</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Equipo</servlet-name>
        <servlet-class>Servlets.Equipo</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Pendiente</servlet-name>
        <servlet-class>Servlets.Pendiente</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Lst_verificacion</servlet-name>
        <servlet-class>Servlets.Lst_verificacion</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Usuario</servlet-name>
        <servlet-class>Servlets.Usuario</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Registro</servlet-name>
        <servlet-class>Servlets.Registro</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Actividad</servlet-name>
        <servlet-class>Servlets.Actividad</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Registro_001</servlet-name>
        <servlet-class>Servlets.Registro_001</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Login</servlet-name>
        <url-pattern>/Login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Bitacora</servlet-name>
        <url-pattern>/Bitacora</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Caso</servlet-name>
        <url-pattern>/Caso</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Calificar_caso</servlet-name>
        <url-pattern>/Calificar_caso</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Detalle_equipo</servlet-name>
        <url-pattern>/Detalle_equipo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Encuesta</servlet-name>
        <url-pattern>/Encuesta</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Equipo</servlet-name>
        <url-pattern>/Equipo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Pendiente</servlet-name>
        <url-pattern>/Pendiente</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Lst_verificacion</servlet-name>
        <url-pattern>/Lst_verificacion</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Usuario</servlet-name>
        <url-pattern>/Usuario</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Registro</servlet-name>
        <url-pattern>/Registro</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Actividad</servlet-name>
        <url-pattern>/Actividad</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Registro_001</servlet-name>
        <url-pattern>/Registro_001</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            120
        </session-timeout>
    </session-config>
    <servlet>
        <servlet-name>Connector</servlet-name>
        <servlet-class>com.fredck.FCKeditor.connector.ConnectorServlet</servlet-class>
        <init-param>
            <param-name>baseDir</param-name>
            <param-value>/UserFiles/</param-value>
        </init-param>
        <init-param>
            <param-name>debug</param-name>
            <param-value>true</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>SimpleUploader</servlet-name>
        <servlet-class>com.fredck.FCKeditor.uploader.SimpleUploaderServlet</servlet-class>
        <init-param>
            <param-name>baseDir</param-name>
            <param-value>/UserFiles/</param-value>
        </init-param>
        <init-param>
            <param-name>debug</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>enabled</param-name>
            <param-value>false</param-value>
        </init-param>
        <init-param>
            <param-name>AllowedExtensionsFile</param-name>
            <param-value/>
        </init-param>
        <init-param>
            <param-name>DeniedExtensionsFile</param-name>
            <param-value>php|php3|php5|phtml|asp|aspx|ascx|jsp|cfm|cfc|pl|bat|exe|dll|reg|cgi</param-value>
        </init-param>
        <init-param>
            <param-name>AllowedExtensionsImage</param-name>
            <param-value>jpg|gif|jpeg|png|bmp</param-value>
        </init-param>
        <init-param>
            <param-name>DeniedExtensionsImage</param-name>
            <param-value/>
        </init-param>
        <init-param>
            <param-name>AllowedExtensionsFlash</param-name>
            <param-value>swf|fla</param-value>
        </init-param>
        <init-param>
            <param-name>DeniedExtensionsFlash</param-name>
            <param-value/>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Connector</servlet-name>
        <url-pattern>/tinyfck/filemanager/connectors/jsp/connector</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SimpleUploader</servlet-name>
        <url-pattern>/tinyfck/filemanager/upload/simpleuploader</url-pattern>
    </servlet-mapping>
</web-app>
